# Where the FastAPI backend (api.py) is listening. Copy this file to
# .env.local; the value is read at build time into the browser bundle, so it
# must be the origin the *browser* can reach, not one only the server can.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# CopilotKit's runtime reports usage telemetry to its vendor by default.
# This product's whole premise is a manufacturer's proprietary warranty and
# failure data, so it is opted out here rather than left on.
COPILOTKIT_TELEMETRY_DISABLED=true
