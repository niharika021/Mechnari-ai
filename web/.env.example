# Where the FastAPI backend (api.py) is listening. Copy this file to
# .env.local; the value is read at build time into the browser bundle, so it
# must be the origin the *browser* can reach, not one only the server can.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# CopilotKit's runtime reports usage telemetry to its vendor by default.
# This product's whole premise is a manufacturer's proprietary warranty and
# failure data, so it is opted out here rather than left on.
COPILOTKIT_TELEMETRY_DISABLED=true

# Firebase web config, for optional Google sign-in. Get these from the
# Firebase console (Project settings -> Your apps -> Web), or via the
# Firebase Management API's webApps/<id>/config.
#
# These are public by design: they ship in the client bundle and identify
# the project rather than authorising anything. Access is controlled by
# Firebase Auth and the API verifying ID tokens, not by keeping these
# hidden. https://firebase.google.com/docs/projects/api-keys
#
# Leave them unset and sign-in simply does not appear - every view still
# works, reports just stay in this browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
