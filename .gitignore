# Environment variables & secrets
.env
.env.*
!.env.example

# Python cache & build outputs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored to the repo root (leading /) - these are setuptools sdist/build
# artifact names, and unanchored they also match unrelated directories
# that happen to share the name, like web/src/lib/ (caught api.ts, the
# whole typed API client, silently - it was never committed until this
# was fixed).
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Streamlit secrets & cache
.streamlit/secrets.toml

# Local demo/runtime state (the draft review queue) - not source data
.mechnari_runtime/

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
