# Copy to .env. Nothing here is required for the deterministic engines -
# every score, gap, Action Priority and backtest figure works with no
# model access at all. This only configures the copilot's prose.

# --- Option A: Vertex AI (recommended) --------------------------------
# Authenticates with your Google Cloud identity - Application Default
# Credentials locally (`gcloud auth application-default login`), the
# service account on Cloud Run - so there is no API key to leak or rotate.
#
# Recommended because as of September 2026 the keys AI Studio issues (the
# new "AQ." format that replaced "AIza") return 401
# ACCESS_TOKEN_TYPE_UNSUPPORTED against the Generative Language API - a
# known Google-side issue with no published fix.
#
# Model names are NOT interchangeable with AI Studio's: Vertex serves
# versioned publisher models and 404s on floating aliases like
# `gemini-flash-latest`. Availability is regional too - gemini-3.5-flash-lite
# serves from `global` but not from us-central1.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MECHNARI_MODEL=gemini-3.7-flash

# --- Option B: AI Studio API key --------------------------------------
# Still supported for anyone holding a working legacy "AIza" key. Leave
# GOOGLE_GENAI_USE_VERTEXAI unset (or false) and set both of these.
# GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
